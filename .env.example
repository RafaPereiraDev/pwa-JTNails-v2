# ===== Ambiente =====
# Use "production" ao hospedar no Render. Em produção, senhas de seed e CORS ficam obrigatórios.
NODE_ENV=development

# ===== Banco de Dados (PostgreSQL) =====
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Local:      DATABASE_URL=postgresql://postgres:senha@localhost:5432/tainara_nails
# Render:     Copie a "Internal Database URL" do painel do banco no Render
DATABASE_URL=postgresql://postgres:senha@localhost:5432/tainara_nails

# ===== Configuração do Servidor =====
PORT=3000

# ===== Segurança / Autenticação =====
# Segredo usado para assinar os tokens JWT.
# IMPORTANTE: gere um valor forte e único para produção.
# Ex (Node): require('crypto').randomBytes(48).toString('hex')
JWT_SECRET=troque_por_um_segredo_forte_e_aleatorio

# Tempo de expiração do token JWT (ex: 12h, 7d, 30m)
JWT_EXPIRES_IN=12h

# ===== CORS =====
# Origens permitidas em produção, separadas por vírgula (sem espaços extras).
# Ex: https://tainaranails.onrender.com
# Em desenvolvimento pode deixar vazio (libera todas as origens).
CORS_ORIGINS=

# ===== Senhas iniciais (seed) =====
# Usadas apenas na primeira inicialização, quando o banco está vazio.
# OBRIGATÓRIAS em produção (NODE_ENV=production).
# Em desenvolvimento, se ficarem vazias, senhas aleatórias são geradas e exibidas no console.
SEED_ADMIN_PASSWORD=
SEED_TAINARA_PASSWORD=
SEED_PROF2_PASSWORD=
