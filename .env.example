# ===== Ambiente =====
# Use "production" ao hospedar no Render. Em produção, senhas de seed e CORS ficam obrigatórios.
NODE_ENV=development

# ===== Banco de Dados (PostgreSQL) =====
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Local:      DATABASE_URL=postgresql://postgres:senha@localhost:5432/tainara_nails
# Render:     Copie a "Internal Database URL" do painel do banco no Render
DATABASE_URL=postgresql://postgres:senha@localhost:5432/tainara_nails

# ===== SSL do Banco (produção) =====
# Para proteger a conexão com o banco contra interceptação (MITM), forneça o
# certificado CA do provedor. No Render, copie o "CA Certificate" do banco.
# Cole o conteúdo do certificado (pode usar \n para quebras de linha).
# Se definido, a verificação do certificado é ativada automaticamente.
DATABASE_CA=
# Alternativa sem CA customizado: force a verificação estrita do certificado.
# Deixe vazio/false para manter o comportamento padrão do Render.
DATABASE_SSL_STRICT=false

# ===== Configuração do Servidor =====
PORT=3000

# ===== Segurança / Autenticação =====
# Segredo usado para assinar os tokens JWT.
# IMPORTANTE: gere um valor forte e único para produção.
# Ex (Node): require('crypto').randomBytes(48).toString('hex')
JWT_SECRET=troque_por_um_segredo_forte_e_aleatorio

# Tempo de expiração do token JWT do painel administrativo (ex: 12h, 7d, 30m)
JWT_EXPIRES_IN=12h

# Tempo de expiração da sessão da CLIENTE na área pública (agendar/consultar).
# Opcional — se não definir, usa 30 dias. Sessão mais longa evita relogin no celular.
CLIENT_JWT_EXPIRES_IN=30d

# ===== CORS =====
# Origens permitidas em produção, separadas por vírgula (sem espaços extras).
# Ex: https://tainaranails.onrender.com
# Em desenvolvimento pode deixar vazio (libera todas as origens).
CORS_ORIGINS=

# ===== Senhas iniciais (seed) =====
# Usadas apenas na primeira inicialização, quando o banco está vazio.
# OBRIGATÓRIAS em produção (NODE_ENV=production).
# Em desenvolvimento, se ficarem vazias, senhas aleatórias são geradas e exibidas no console.
SEED_ADMIN_PASSWORD=
SEED_TAINARA_PASSWORD=
SEED_PROF2_PASSWORD=

# ===== Cron (lembretes automáticos) =====
# Segredo para proteger as rotas de cron. Configure agendadores externos
# (Render Cron Jobs ou cron-job.org) para chamar:
#   1) Toda SEGUNDA de manhã — lembrete de aniversariantes da semana:
#      GET https://SEU_DOMINIO/api/public/cron/birthday-reminders?secret=SEU_SEGREDO
#   2) A cada ~5 min (horário comercial) — aviso de "atendimento agora" à profissional:
#      GET https://SEU_DOMINIO/api/public/cron/upcoming-reminders?secret=SEU_SEGREDO
CRON_SECRET=

# ===== Agendador interno (Railway) =====
# No Railway (que NÃO hiberna), ative o agendador interno (node-cron) para dispensar
# o cron externo. Com "true", o próprio servidor envia os lembretes:
#   - "*/5 * * * *"  atendimento agora (a cada 5 minutos)
#   - "0 8 * * 1"    aniversariantes da semana (segundas às 08:00, America/Sao_Paulo)
# Deixe vazio/false no Render (que hiberna).
ENABLE_INTERNAL_CRON=false

# ===== Web Push (notificações) =====
# Gere as chaves com: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com
